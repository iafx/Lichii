+/// Changes the haptics volume while the DSP runs (10-125 %; 100 % = calibrated ceiling, 125 % =
+/// actuators' full scale). Returns 1 on success, 0 for a null DSP.
+#[no_mangle]
+pub unsafe extern "C" fn renhdrum_dualsense_dsp_set_volume(
+    dsp: *mut RenHdcDualSenseDsp,
+    volume_percent: i32,
+) -> i32 {
+    let Some(dsp) = (unsafe { dsp.as_ref() }) else {
+        return 0;
+    };
+    if let Ok(mut inner) = dsp.inner.lock() {
+        inner.set_volume(volume_percent);
+        1
+    } else {
+        0
+    }
+}
