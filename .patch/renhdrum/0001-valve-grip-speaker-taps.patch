+    /// Clicks on the left side: the speaker taps reach the left grip on the cable (8 kHz) only.
+    #[test]
+    fn test_speaker_taps_on_the_cable_only() {
+        for (format, expect_taps) in [
+            (VALVE_GRIP_FORMAT_MULAW_8K, true),
+            (VALVE_GRIP_FORMAT_MULAW_4K, false),
+        ] {
+            let mut plain = DualSenseHapticsDsp::new_grip(100, false);
+            let mut tapped = DualSenseHapticsDsp::new_grip(100, false);
+            tapped.set_speaker(60);
+            let (mut a, mut b) = (ValveGripPacker::default(), ValveGripPacker::default());
+            let (mut ra, mut rb) = ([0u8; VALVE_GRIP_REPORT_SIZE], [0u8; VALVE_GRIP_REPORT_SIZE]);
+            let mut left_differs = false;
+            for n in 0..400 {
+                let click = n % 40 < 3;
+                for dsp in [&mut plain, &mut tapped] {
+                    dsp.set_half_target(false, 0.1, 160.0, if click { 0.7 } else { 0.0 }, 320.0);
+                }
+                a.build(&mut plain, format, &mut ra);
+                b.build(&mut tapped, format, &mut rb);
+                left_differs |= ra[LEFT_OFFSET..RIGHT_OFFSET] != rb[LEFT_OFFSET..RIGHT_OFFSET];
+                assert_eq!(
+                    ra[RIGHT_OFFSET..],
+                    rb[RIGHT_OFFSET..],
+                    "right grip got left taps"
+                );
+            }
+            assert_eq!(left_differs, expect_taps, "format {format}");
+        }
+    }
