+    /// One speaker sample per grip: each side's taps through the speaker high-pass and a 400 Hz
+    /// high-pass, at the speaker level. Experimental (iafx): measured by ear on one Steam
+    /// Controller (2026) over its cable, where beeps and chirps sounded like a DualSense speaker.
+    fn next_grip_speaker_samples(&mut self, c: &SpkCoefs) -> [f32; 2] {
+        let gain = self.speaker_gain as f64;
+        let l = self.spk_left.next_sample(c);
+        let r = self.spk_right.next_sample(c);
+        let [b0, b1, b2, a1, a2] = SPEAKER_HP;
+        let yl = b0 * l + b1 * self.spk_hp_x[0] + b2 * self.spk_hp_x[1]
+            - a1 * self.spk_hp_y[0]
+            - a2 * self.spk_hp_y[1];
+        self.spk_hp_x = [l, self.spk_hp_x[0]];
+        self.spk_hp_y = [yl, self.spk_hp_y[0]];
+        let h = &mut self.grip_spk_hp_right;
+        let yr = b0 * r + b1 * h[0] + b2 * h[1] - a1 * h[2] - a2 * h[3];
+        *h = [r, h[0], yr, h[2]];
+        let mut out = [0.0f32; 2];
+        for (i, x) in [yl, yr].into_iter().enumerate() {
+            let [b0, b1, b2, a1, a2] = GRIP_SPEAKER_HP400;
+            let h = &mut self.grip_spk_hp400[i];
+            let y = b0 * x + b1 * h[0] + b2 * h[1] - a1 * h[2] - a2 * h[3];
+            *h = [x, h[0], y, h[2]];
+            out[i] = (y * gain).clamp(-0.98, 0.98) as f32;
+        }
+        out
+    }
