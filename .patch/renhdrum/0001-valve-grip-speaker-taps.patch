+    #[test]
+    fn test_soft_limit_leaves_the_vibration_alone() {
+        for x in [-0.8f32, -0.3, 0.0, 0.42, 0.8] {
+            assert_eq!(soft_limit(x), x);
+        }
+        assert!(soft_limit(1.4) < 1.0 && soft_limit(1.4) > 0.8);
+        assert_eq!(soft_limit(-1.4), -soft_limit(1.4));
+    }
