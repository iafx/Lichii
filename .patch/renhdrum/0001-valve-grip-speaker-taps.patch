+/// Leaves `x` as it is up to the DualSense output ceiling (0.8, where the vibration alone ends)
+/// and bends what the speaker taps add above it smoothly towards 1.
+#[inline]
+fn soft_limit(x: f32) -> f32 {
+    const KNEE: f32 = 0.8;
+    let a = x.abs();
+    if a <= KNEE {
+        x
+    } else {
+        (KNEE + (1.0 - KNEE) * ((a - KNEE) / (1.0 - KNEE)).tanh()).copysign(x)
+    }
+}
