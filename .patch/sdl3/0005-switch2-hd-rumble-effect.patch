 static bool HIDAPI_DriverSwitch2_SendJoystickEffect(SDL_HIDAPI_Device *device, SDL_Joystick *joystick, const void *data, int size)
 {
-    return SDL_Unsupported();
+    SDL_DriverSwitch2_Context *ctx = (SDL_DriverSwitch2_Context *)device->context;
+    const Uint8 *effect = (const Uint8 *)data;
+
+    if (!effect || size != SWITCH2_HD_RUMBLE_EFFECT_SIZE || SDL_memcmp(effect, "HDR2", 4) != 0) {
+        return SDL_Unsupported();
+    }
+    if (device->product_id == USB_PRODUCT_NINTENDO_SWITCH2_GAMECUBE_CONTROLLER) {
+        return SDL_Unsupported();
+    }
+    if (device->is_bluetooth) {
+        // Only the USB rumble path below plays HD rumble. A Bluetooth path must put
+        // EncodeHDRumbleMotor() in its motor blocks before this check is removed; until then the
+        // caller gets "unsupported" and can fall back to SDL_RumbleJoystick().
+        return SDL_Unsupported();
+    }
+    for (int motor = 0; motor < 2; ++motor) {
+        const Uint8 *m = &effect[5 + motor * 8];
+        ctx->hd_lo_freq[motor] = (Uint16)((m[0] | (m[1] << 8)) & 0x3FF);
+        ctx->hd_lo_amp[motor] = (Uint16)SDL_min(m[2] | (m[3] << 8), 0x3FF);
+        ctx->hd_hi_freq[motor] = (Uint16)((m[4] | (m[5] << 8)) & 0x3FF);
+        ctx->hd_hi_amp[motor] = (Uint16)SDL_min(m[6] | (m[7] << 8), 0x3FF);
+    }
+    ctx->hd_rumble = true;
+    SDL_SetAtomicInt(&device->hd_pause_ms, SWITCH2_HD_RUMBLE_PAUSE_MS);
+    ctx->hd_rumble_expire = SDL_GetTicks() + SWITCH2_HD_RUMBLE_HOLD_MS;
+    ctx->rumble_updated = true;
+    UpdateRumble(ctx);
+    return true;
 }
 
