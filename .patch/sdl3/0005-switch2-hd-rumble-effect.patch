+// One motor's HD rumble operation: low band frequency (bits 0-8), low band amplitude (10-19),
+// high band frequency (20-28), high band amplitude (30-39)
+static void EncodeHDRumble2(Uint16 lo_freq, Uint16 lo_amp, Uint16 hi_freq, Uint16 hi_amp, Uint8 rumble_data[5])
+{
+    Uint64 w = (Uint64)(lo_freq & 0x1FF) | ((Uint64)(lo_amp & 0x3FF) << 10) |
+               ((Uint64)(hi_freq & 0x1FF) << 20) | ((Uint64)(hi_amp & 0x3FF) << 30);
+    for (int i = 0; i < 5; ++i) {
+        rumble_data[i] = (Uint8)(w >> (8 * i));
+    }
+}
+
+// Fills one motor's 5-byte operation (0 = left, 1 = right) from the HD rumble effect. Returns
+// false when no HD rumble effect is playing. The operation is the same over every transport; only
+// the packet around it differs.
+static bool EncodeHDRumbleMotor(SDL_DriverSwitch2_Context *ctx, int motor, Uint8 rumble_data[5])
+{
+    if (!ctx->hd_rumble) {
+        return false;
+    }
+    EncodeHDRumble2(ctx->hd_lo_freq[motor], ctx->hd_lo_amp[motor], ctx->hd_hi_freq[motor],
+                    ctx->hd_hi_amp[motor], rumble_data);
+    return true;
+}
