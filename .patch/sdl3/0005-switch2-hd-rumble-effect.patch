+#define SWITCH2_HD_RUMBLE_EFFECT_SIZE 21
+#define SWITCH2_HD_RUMBLE_HOLD_MS     60
+// A motor block holds three operations, about 15 ms of rumble, but the controller plays through
+// them faster than that: one packet every 15 ms (or 10) left it short now and then, and every gap
+// shook the motor at its own resonance, which sounded like noise over the tone. One packet every
+// 8 ms keeps it fed and plays clean (checked by ear and against a DualSense on a Pro Controller).
+#define SWITCH2_HD_RUMBLE_INTERVAL    8
+// Pause of the rumble thread after each HD rumble write: its 10 ms default would hold the packets
+// back to ~11 ms apart
+#define SWITCH2_HD_RUMBLE_PAUSE_MS    1
+
+// HD rumble effect: "HDR2", a flags byte (reserved, 0), then for the left and the right motor
+// (Uint16 little endian each): low band frequency code, low band amplitude (0-1023), high band
+// frequency code, high band amplitude (0-1023). Frequency codes are 10 bits: Hz = 10 * 2^(code / 96)
+// (measured on a Pro Controller). Each effect plays for SWITCH2_HD_RUMBLE_HOLD_MS; send again to keep it going.
+// It goes out right away (within the rumble interval) instead of waiting for the next input report.
+static bool UpdateRumble(SDL_DriverSwitch2_Context *ctx);
